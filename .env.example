# MAYA AI (MYAI) environment variables.
#
# Copy this file to ".env" (which is ignored by Git) and fill in real values there.
# Never commit ".env" or put real secrets in this file.
#
# Local-only examples. Replace these values outside source control before non-local use.
POSTGRES_DB=maya
POSTGRES_USER=maya_migrator
POSTGRES_PASSWORD=example-migration-only
POSTGRES_APP_PASSWORD=example-runtime-only
POSTGRES_PORT=15432
REDIS_PORT=16379
MAYA_DATABASE_URL=postgresql+asyncpg://maya_app:example-runtime-only@127.0.0.1:15432/maya
MAYA_MIGRATION_DATABASE_URL=postgresql+asyncpg://maya_migrator:example-migration-only@127.0.0.1:15432/maya
MAYA_REDIS_URL=redis://127.0.0.1:16379/0
MAYA_PROBE_TIMEOUT_SECONDS=2
# Authentication keys (at least 32 bytes each, different from each other).
# These local-only examples are public; generate private random values for any shared use.
MAYA_JWT_SIGNING_KEY=example-jwt-signing-key-for-local-development-only-0000
MAYA_OTP_HMAC_KEY=example-otp-hmac-key-for-local-development-only-0000
MAYA_ACCESS_TOKEN_TTL_SECONDS=900
MAYA_REFRESH_TOKEN_TTL_SECONDS=604800
MAYA_REFRESH_ABSOLUTE_TTL_SECONDS=2592000
MAYA_OTP_RESEND_COOLDOWN_SECONDS=60
# Outbound e-mail for one-time codes. Leave unset to disable e-mail; real values stay in the
# untracked .env file.
# MAYA_SMTP_HOST=smtp.example.com
# MAYA_SMTP_PORT=587
# MAYA_SMTP_SECURITY=starttls
# MAYA_SMTP_USERNAME=mailer@example.com
# MAYA_SMTP_PASSWORD=replace-in-private-env
# MAYA_SMTP_FROM_ADDRESS=mailer@example.com
