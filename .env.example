# MAYA AI (MYAI) environment variables.
#
# Copy this file to ".env" (which is ignored by Git) and fill in real values there.
# Never commit ".env" or put real secrets in this file.
#
# Local-only examples. Replace these values outside source control before non-local use.
POSTGRES_DB=maya
POSTGRES_USER=maya_migrator
POSTGRES_PASSWORD=example-migration-only
POSTGRES_APP_PASSWORD=example-runtime-only
POSTGRES_PORT=15432
REDIS_PORT=16379
MAYA_DATABASE_URL=postgresql+asyncpg://maya_app:example-runtime-only@127.0.0.1:15432/maya
MAYA_MIGRATION_DATABASE_URL=postgresql+asyncpg://maya_migrator:example-migration-only@127.0.0.1:15432/maya
MAYA_REDIS_URL=redis://127.0.0.1:16379/0
MAYA_PROBE_TIMEOUT_SECONDS=2
# Authentication keys (at least 32 bytes each, different from each other).
# These local-only examples are public; generate private random values for any shared use.
MAYA_JWT_SIGNING_KEY=example-jwt-signing-key-for-local-development-only-0000
MAYA_OTP_HMAC_KEY=example-otp-hmac-key-for-local-development-only-0000
MAYA_ACCESS_TOKEN_TTL_SECONDS=900
MAYA_REFRESH_TOKEN_TTL_SECONDS=604800
MAYA_REFRESH_ABSOLUTE_TTL_SECONDS=2592000
# Secure cookies are the default. Plain-HTTP local use may need false, depending on the browser.
MAYA_AUTH_COOKIE_SECURE=true
MAYA_OTP_RESEND_COOLDOWN_SECONDS=60
# Outbound e-mail for one-time codes. Leave unset to disable e-mail; real values stay in the
# untracked .env file.
# MAYA_SMTP_HOST=smtp.example.com
# MAYA_SMTP_PORT=587
# MAYA_SMTP_SECURITY=starttls
# MAYA_SMTP_USERNAME=mailer@example.com
# MAYA_SMTP_PASSWORD=replace-in-private-env
# MAYA_SMTP_FROM_ADDRESS=mailer@example.com
# Your own mailbox, so MAYA can read your mail and send mail you approve (IMAP + SMTP, app
# password). For Gmail: turn on 2-Step Verification, then create an App Password at
# myaccount.google.com/apppasswords. Set both or neither. Real values stay in the untracked .env.
# MAYA_MAIL_ADDRESS=you@gmail.com
# MAYA_MAIL_APP_PASSWORD=replace-in-private-env
# MAYA_MAIL_IMAP_HOST=imap.gmail.com
# MAYA_MAIL_IMAP_PORT=993
# MAYA_MAIL_SMTP_HOST=smtp.gmail.com
# MAYA_MAIL_SMTP_PORT=465
# MAYA_MAIL_ENABLED=true

# Tool credentials for the MCP gateway (all optional; placeholders only)
# MAYA_GITHUB_TOKEN=replace-in-private-env
# MAYA_NOTION_TOKEN=replace-in-private-env
# Who may use the server-level tokens above (account emails or user ids, comma-separated).
# Empty means nobody: every user connects their own accounts in Settings > Connections.
MAYA_ENV_CONNECTIONS_USERS=
# Per-user connections (Settings > Connections): 32 random bytes, base64. Generate with
# python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# MAYA_CONNECTIONS_ENCRYPTION_KEY=replace-in-private-env
# MAYA_NOTION_DATABASE_ID=replace-with-your-notion-database-id
# Native web search: free engines that need no key, in the order they are tried. Google Search
# grounding (gemini) is OFF by default (its quota runs out); add ",gemini" here only to opt in.
# Known names: hn, arxiv, stackexchange (only for a query with a clear signal), ddgs (rotation of
# DuckDuckGo, Bing, Brave, Yahoo, Mojeek), searxng, brave, tavily, wikipedia, gemini.
MAYA_SEARCH_PROVIDERS=hn,arxiv,stackexchange,ddgs,searxng,brave,tavily,wikipedia
# ddgs engines in rotation order (google is not allowed). A blocked engine cools down 2, 4 ... 30 min.
MAYA_DDGS_ENGINES=duckduckgo,bing,brave,yahoo,mojeek
# SearXNG instances (comma list of base URLs with the JSON format enabled); empty = not used.
MAYA_SEARXNG_URLS=
# Provider calls at once in this process, and the minimum gap per engine in milliseconds.
MAYA_SEARCH_CONCURRENCY=2
MAYA_SEARCH_ENGINE_SPACING_MS=400
# Optional keys; a provider whose key is unset is skipped.
# MAYA_BRAVE_API_KEY=replace-in-private-env
# MAYA_TAVILY_API_KEY=replace-in-private-env
# Searches one user may run per minute (a guard against loops)
# MAYA_SEARCH_RATE_LIMIT_PER_MINUTE=20
# Backend of ordinary research task steps: native (MAYA's own search + page reading, default),
# grounding (Gemini Google Search first) or auto (native, grounding only when native found nothing).
MAYA_RESEARCH_BACKEND=native
# Deep research (ADR-0032): the composer brain toggle. Caps are per run.
MAYA_DEEP_RESEARCH_ENABLED=true
# Largest learning book MAYA builds, in pages (about 450 words a page; default 200, chapters capped at 80).
MAYA_LEARNING_BOOK_MAX_PAGES=200
MAYA_DEEP_RESEARCH_MIN_DOMAINS=20
MAYA_DEEP_RESEARCH_MAX_SOURCES=40
MAYA_DEEP_RESEARCH_HARD_MAX_SOURCES=60
MAYA_DEEP_RESEARCH_TIME_CAP_SECONDS=600
MAYA_DEEP_RESEARCH_MAX_MODEL_CALLS=60
MAYA_DEEP_RESEARCH_MAX_ROUNDS=2
MAYA_DEEP_RESEARCH_FETCH_CONCURRENCY=6
# Scheduled reports (ADR-0033). false stops the runner loop (the API and settings stay).
MAYA_SCHEDULES_ENABLED=true
MAYA_SCHEDULES_POLL_SECONDS=30
MAYA_SCHEDULES_RUN_MAX_MINUTES=15
MAYA_SCHEDULES_RUN_MAX_MODEL_CALLS=40
# Gemini decision model (ADR-0029): advisory yes/no, pick-one and score checks; every call fails
# open to the previous behaviour. Uses the Gemini keys above. false switches it off.
MAYA_DECISIONS_ENABLED=true
MAYA_DECISIONS_MODEL=gemini-decision-1
MAYA_DECISIONS_TIMEOUT_SECONDS=3
# MAYA_DECISIONS_BACKGROUND_TIMEOUT_SECONDS=8
# Comma list of purposes to switch off: route,search_need,grounding,task_verify,doc_quality,
# approval_check,injection,mail_triage,voice_digest,memory,planner_hint
# MAYA_DECISIONS_DISABLED_PURPOSES=
# MAYA_DECISIONS_MAX_PER_MINUTE=60
# Step review: off | advisory (a note only, never changes status) | enforce (strong, corroborated
# flags mark the task "finished with problems").
MAYA_STEP_REVIEW_MODE=advisory
# Calendar adapter only; never used for mail (mail uses the mailbox in Settings > Connections).
# MAYA_GOOGLE_ACCESS_TOKEN=replace-in-private-env
# MAYA_GOOGLE_CLIENT_ID=replace-in-private-env
# MAYA_GOOGLE_CLIENT_SECRET=replace-in-private-env
# MAYA_GOOGLE_REFRESH_TOKEN=replace-in-private-env
# MAYA_ARTIFACTS_DIR=storage/artifacts
# Uploaded files (ADR-0022): lower the per-file (25 MB) and per-request (60 MB) caps if needed.
# MAYA_UPLOAD_MAX_BYTES=26214400
# MAYA_UPLOAD_TOTAL_MAX_BYTES=62914560

# Model Gateway (Phase 03)
# MAYA_GEMINI_API_KEY=example-gemini-key-not-real
# MAYA_GEMINI_API_KEYS=example-gemini-key-1-not-real,example-gemini-key-2-not-real
# MAYA_GEMINI_MODEL_OVERRIDES={}
# MAYA_GEMINI_VERIFY_MODELS_ON_STARTUP=false
# MAYA_GEMINI_REQUEST_TIMEOUT_SECONDS=30.0
# Interactive chat only: seconds one model attempt may take to its first chunk (default 20) and
# the budget for the whole failover chain before the turn ends with an honest "model overloaded"
# message and a Retry button (default 75).
# MAYA_GATEWAY_FIRST_CHUNK_TIMEOUT_SECONDS=20.0
# MAYA_GATEWAY_TOTAL_DEADLINE_SECONDS=75.0
# Most different keys one call may try (1 to 17); failover to the next key is instant
# MAYA_GEMINI_MAX_KEY_ATTEMPTS=4
# Most keys tried on a quota (429) failure before the next model (default 8, 1 to 64).
# MAYA_GEMINI_MAX_QUOTA_KEY_ATTEMPTS=8
# Per-attempt cap for agent and task model calls (chapters take 30-120 s); chat keeps the 30 s above
# MAYA_AGENT_REQUEST_TIMEOUT_SECONDS=150
# Model for every agent and task call: lite, orchestrator or heavy (live is refused)
# MAYA_AGENT_MODEL_ALIAS=lite
# Alias agent calls may fall back to after all keys fail; empty means no fallback
# MAYA_AGENT_FALLBACK_ALIAS=
# MAYA_BUDGET_ENFORCEMENT_MODE=log_only
# MAYA_GEMINI_BUDGET_TASK_USD_ALERT=1.50
# MAYA_GEMINI_MAX_TOOL_TURNS_ALERT=10
# MAYA_GEMINI_BUDGET_TASK_USD_CAP=1.50
# MAYA_GEMINI_MAX_TOOL_TURNS_CAP=10
# How many subtasks (of any task) run side by side in the API process (1 to 8, default 3).
# MAYA_TASK_WORKER_CONCURRENCY=3

# Chat: Output tokens (65536 max matching Gemini capacity), context budget (1M), deadline (600s).
# MAYA_CHAT_RATE_LIMIT_PER_MINUTE=20
# MAYA_CHAT_CONTEXT_TOKEN_BUDGET=1000000
# MAYA_CHAT_INTENT_CLASSIFIER=false
# Inline chat files (small text files made in the chat) and the chat router. false = kill switch.
MAYA_CHAT_INLINE_FILES=true
# Chat tool loop (create_document, preview_document, start_job, check_job) for document, deck and
# website requests. Phase 1, off by default; it needs MAYA_CHAT_INLINE_FILES=true. false = previous.
# MAYA_CHAT_TOOL_LOOP=false
# Gemini thought summaries for the live step list ("think" steps). Summaries only, never raw
# thoughts. Thought tokens are billed at the output rate and add latency. false = no thinking config.
# MAYA_THINKING_SUMMARIES=true
# Image creation in chat and live voice (generate_image). The image model is separate from the
# chat model; set MAYA_IMAGE_MODEL to an image model your Gemini key can use. Daily limit is per
# user (UTC day); 0 turns images off.
# MAYA_IMAGE_MODEL=gemini-3.1-flash-image
# MAYA_IMAGE_DAILY_LIMIT=20
# MAYA_IMAGE_REQUEST_TIMEOUT_SECONDS=60
# MAYA_CHAT_MAX_CONCURRENT_STREAMS_PER_USER=2
MAYA_CHAT_REPLY_DEADLINE_SECONDS=600
# MAYA_CHAT_MAX_OUTPUT_TOKENS=65536

# API hygiene and desktop profile. All optional; the defaults are the safe ones.
# "development" turns the /docs, /redoc and /openapi.json pages on (MAYA_API_DOCS_ENABLED overrides).
MAYA_ENVIRONMENT=development
# MAYA_API_DOCS_ENABLED=false
# Host header allow-list (comma separated or JSON list).
# MAYA_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to open the live voice WebSocket.
# MAYA_VOICE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Live voice speaks task milestones (done, failed, approval, input needed) on its own.
# MAYA_VOICE_TASK_ANNOUNCE=true
# Runtime tools (model-written Python run in an isolated container; off by default, see
# backend/app/runtime_tools/README.md). Without a sandbox image every run is refused.
# MAYA_RUNTIME_TOOLS_ENABLED=false
# MAYA_RUNTIME_TOOLS_SANDBOX_IMAGE=
# MAYA_RUNTIME_TOOLS_TIMEOUT_SECONDS=60
# MAYA_RUNTIME_TOOLS_MAX_RUNS_PER_TURN=3
# Sandbox execution (Decision D14): explicit Docker container isolation (true) vs local subprocess
# execution fallback (false). When unset, auto-detects Docker CLI and daemon availability.
MAYA_SANDBOX_USE_DOCKER=false
# MCP client (third-party MCP servers such as Playwright and GitHub, run as child processes on
# THIS machine; off by default, see backend/app/mcp_client/README.md). Each server also needs to be
# enabled and pinned to an exact version in the servers file.
# MAYA_MCP_CLIENT_ENABLED=false
# Desktop app only: set to 0 to stop MAYA saying hello (offline PC voice) while it starts.
MAYA_STARTUP_GREETING=1
# MAYA's Gemini Live voice (a female voice: Leda, Zephyr, Aoede, Achernar, Vindemiatrix, Sulafat, ...).
MAYA_VOICE_NAME=Leda
# MAYA_MCP_SERVERS_FILE=
# MAYA_MCP_CALL_TIMEOUT_SECONDS=30
# MAYA_MCP_START_TIMEOUT_SECONDS=60
# MAYA_MCP_MAX_CALLS_PER_TURN=6
# MAYA_MCP_MAX_OUTPUT_CHARS=20000
# MAYA_MCP_MAX_TOOLS_PER_TURN=12
# Serve the exported web app from the API (desktop). Path to the export directory.
# MAYA_WEB_STATIC_DIR=
# First-run owner creation without e-mail, loopback peers and an empty database only (ADR-0014).
# `python -m app.desktop` turns it on; keep it false for any server.
MAYA_LOCAL_OWNER_BOOTSTRAP=false
# `python -m app` reads this file when --env-file is not given (exactly this file, nothing else).
# MAYA_ENV_FILE=
# Desktop build/test switches (apps/desktop, apps/web): 1 builds the static web export; 1 runs the shell
# headless for `npm --prefix apps/desktop run smoke`. Not used by the API.
MAYA_DESKTOP_EXPORT=0
MAYA_DESKTOP_SMOKE=0

# Web client (apps/web). Server-side upstream for the same-origin API proxy; never a secret.
MAYA_API_PROXY_TARGET=http://127.0.0.1:8000
# Override for the live voice WebSocket URL (defaults to ws://127.0.0.1:8000/api/v1/voice/live)
NEXT_PUBLIC_VOICE_WS_URL=ws://127.0.0.1:8000/api/v1/voice/live
