# MAYA AI (MYAI) environment variables.
#
# Copy this file to ".env" (which is ignored by Git) and fill in real values there.
# Never commit ".env" or put real secrets in this file.
#
# Local-only examples. Replace these values outside source control before non-local use.
POSTGRES_DB=maya
POSTGRES_USER=maya_migrator
POSTGRES_PASSWORD=example-migration-only
POSTGRES_APP_PASSWORD=example-runtime-only
POSTGRES_PORT=15432
REDIS_PORT=16379
MAYA_DATABASE_URL=postgresql+asyncpg://maya_app:example-runtime-only@127.0.0.1:15432/maya
MAYA_MIGRATION_DATABASE_URL=postgresql+asyncpg://maya_migrator:example-migration-only@127.0.0.1:15432/maya
MAYA_REDIS_URL=redis://127.0.0.1:16379/0
MAYA_PROBE_TIMEOUT_SECONDS=2
