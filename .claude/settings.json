{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run validate)",
      "Bash(npm run validate:fast)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run docs:check)",
      "Bash(npm run security:check)",
      "Bash(npm run agents:check)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git tag *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git config *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npm update *)",
      "Bash(npm uninstall *)",
      "Bash(npm publish *)",
      "Bash(npx *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(docker *)",
      "Bash(rm *)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./GEMINI.md)",
      "Edit(./governance/**)",
      "Edit(./.github/workflows/**)",
      "Edit(./.github/dependabot.yml)",
      "Edit(./.github/copilot-instructions.md)",
      "Edit(./.github/instructions/**)",
      "Edit(./scripts/hooks/**)",
      "Edit(./scripts/validation/**)",
      "Edit(./scripts/governance/**)",
      "Edit(./scripts/lib/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./package.json)",
      "Edit(./package-lock.json)",
      "Edit(**/migrations/**)",
      "Edit(./docker/**)",
      "Edit(./Dockerfile*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.test)",
      "Read(.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Read(**/*.tfstate)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.npmrc)",
      "Read(~/.git-credentials)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.production)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(./secrets/**)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease*)",
      "Bash(* --no-verify*)",
      "Bash(* --no-gpg-sign*)",
      "Bash(git config core.hooksPath *)"
    ]
  }
}
